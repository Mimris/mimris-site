{
  "name": "mimris-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "sync:static": "mkdir -p public && rm -f public/index.html && rm -rf public/assets && cp legacy-home.html press.html metis-legacy.html styles.css robots.txt sitemap.xml llms.txt public/ && cp -R assets public/assets",
    "predev": "npm run sync:static",
    "dev": "next dev",
    "prebuild": "npm run sync:static",
    "build": "next build",
    "start": "next start"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "type": "module"
}
